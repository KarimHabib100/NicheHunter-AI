# Database
DATABASE_URL="file:./dev.db"

# Authentication (REQUIRED - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# App URL
APP_URL="http://localhost:3000"

# Whisper Model (optional - defaults to "base")
# Options: tiny, base, small, medium, large
WHISPER_MODEL="base"

# Feature Flags
ENABLE_MOCK_TRANSCRIPTION="true"
ENABLE_ANALYTICS="false"

# Limits
MAX_VIDEO_DURATION="600"  # seconds (10 minutes)
MAX_FILE_SIZE="104857600" # bytes (100MB)
